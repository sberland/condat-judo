# Variables du développement local — copier ce fichier en `.dev.vars` (non commité).
# wrangler dev les superpose aux [vars] de wrangler.toml.

# Active le fournisseur d'identité de dev (jamais actif hors ENVIRONMENT=local).
ENVIRONMENT=local

# Utilisateur simulé : subject de la table `identites` (provider 'dev') — cf. src/db/seed.sql.
#   dev-admin  → Admin Dev (rôle admin)
#   dev-bureau → Bureau Dev (rôles bureau + contenu)
#   dev-parent → Parent Dev (famille : deux enfants)
#   dev-encadrant → Encadrant Dev (rôle encadrant : mercredi du jour)
# Une vraie session (lien de connexion, spec 005a) prime sur l'utilisateur simulé. Pour tester la
# connexion par lien en partant d'un visiteur anonyme, vider DEV_SUBJECT (cf. workflow-dev-spe.md).
DEV_SUBJECT=dev-admin
